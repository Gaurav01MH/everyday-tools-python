{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "files-format-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp*", "/health"]
  }
}
