  "dependencies": {
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "@playwright/test": "1.65.1",
    "axe-core": "4.14.1"
  }
}
